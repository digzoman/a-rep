# A Rep V1.3 agent runtime config. No secrets.
AGENT_ID="fred"
AGENT_ROLE="Founder"
AGENT_REPO="digzoman/fred"
AGENT_REPO_DIR="/srv/fred"

A_REP_REPO="digzoman/a-rep"
A_REP_REF="main"
A_REP_SKILL_PATH="/opt/a-rep/a-rep/SKILL.md"

EXECUTION_DRIVER="codex" # codex | opencode
EXECUTION_BIN="codex"
EXECUTION_MODEL=""

# Optional producer-provenance labels for launcher-run PRIMARY cycles.
# Platform defaults to EXECUTION_DRIVER; Instance defaults to runtime-heartbeat/runtime-rejuvenation.
# If this one config drives several cycle types, use a cycle-neutral host label.
PROVENANCE_PLATFORM="Codex"
PROVENANCE_INSTANCE="VM-runtime"

HEARTBEAT_ENABLED="true"
HEARTBEAT_MODE="normal" # fast | normal | slow | paused
HEARTBEAT_FAST_MINUTES="5"
HEARTBEAT_NORMAL_MINUTES="15"
HEARTBEAT_SLOW_MINUTES="60"
DEADLINE_MODE="false"

REJUVENATION_ENABLED="true"

RUNTIME_DIR=".arep"
LOG_DIR=".arep/raw-logs"
LOCK_FILE=".arep/primary.lock"
HEARTBEAT_LAST_FILE=".arep/heartbeat.last"
